# Copy this to .streamlit/secrets.toml locally (already gitignored) and fill
# in real values. On Streamlit Community Cloud, paste these into your app's
# Settings -> Secrets instead - never commit real secrets to the repo.

GEMINI_API_KEY = "your-gemini-key-here"
COOKIES_PASSWORD = "any-random-string-used-to-encrypt-the-device-id-cookie"
ADMIN_PASSWORD = "a-password-only-you-know-to-view-analytics"

# Optional - only needed if you want to use pages/Review.py to occasionally
# tweak a day's picks. Without these, Review still works but only writes
# locally (won't survive a redeploy). REVIEW_PASSWORD defaults to
# ADMIN_PASSWORD if not set separately.
# REVIEW_PASSWORD = "a-password-for-the-optional-review-page"
# GITHUB_TOKEN = "a-fine-grained-PAT-scoped-to-just-this-repo-contents-write"
# GITHUB_REPO = "yourname/your-repo-name"
# GITHUB_BRANCH = "main"
